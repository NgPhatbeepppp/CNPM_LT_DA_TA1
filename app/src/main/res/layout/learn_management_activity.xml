<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white">

    <!-- Ô tìm kiếm có bo góc, icon tìm kiếm -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Tìm kiếm..."
        android:padding="12dp"
        android:background="@drawable/rounded_edittext"
        android:textSize="16sp"
        android:drawableLeft="@drawable/ic_search"
        android:drawablePadding="8dp"
        android:elevation="2dp"
        android:layout_marginBottom="16dp"/>

    <!-- Nhóm nút chức năng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnFlashcards"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:background="@drawable/rounded_button_pink"
            android:text="Flashcard"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:gravity="center"/>

        <Button
            android:id="@+id/btnFlashcardSets"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:background="@drawable/rounded_button_blue"
            android:text="FCSet"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:gravity="center"/>

        <Button
            android:id="@+id/btnCourses"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:background="@drawable/rounded_button_pink"
            android:text="Course"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:gravity="center"/>
    </LinearLayout>

    <!-- RecyclerView có bo góc và bóng đổ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/rounded_recyclerview"
        android:elevation="4dp"
        android:padding="12dp"
        android:scrollbars="vertical"
        android:layout_marginBottom="16dp"/>

    <!-- Button thay cho FloatingActionButton "Thêm" -->
    <Button
        android:id="@+id/btnAddItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/pink"
        android:text="Thêm"
        android:textColor="@color/white"
        android:drawableLeft="@drawable/ic_add"
        android:drawablePadding="8dp"
        android:gravity="center"/>

</LinearLayout>
